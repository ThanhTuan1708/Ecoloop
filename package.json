{
  "name": "ecoloop-avalanche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run contracts:compile",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/start.mjs",
    "build": "npm run contracts:compile && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "contracts:compile": "node scripts/compile.mjs",
    "test": "npm run contracts:compile && node --test tests/*.test.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "theme:dark": "node scripts/gen-dark-theme.mjs",
    "chain": "hardhat node",
    "deploy:local": "node scripts/deploy.mjs --local",
    "deploy:fuji": "node --env-file=.env scripts/deploy.mjs",
    "deploy:pickup:local": "node scripts/deploy-pickup.mjs --local",
    "deploy:pickup:fuji": "node --env-file=.env scripts/deploy-pickup.mjs",
    "seed:local": "node scripts/seed-fuji.mjs --local",
    "seed:fuji": "node --env-file=.env scripts/seed-fuji.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "thirdweb": "^5.122.1",
    "viem": "^2.38.0"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "hardhat": "^3.0.0",
    "solc": "0.8.37",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
