# Browser configuration: copy to .env. Never prefix a private key with VITE_.
VITE_ECOLOOP_ADDRESS=
VITE_CHAIN_ID=43113
# Optional Google login. Public client ID only, never a thirdweb secret key.
VITE_THIRDWEB_CLIENT_ID=
# Enable only after configuring an allowlisted Fuji paymaster policy for EcoLoop contracts.
# Switching EOA -> smart account changes the Google wallet address. Decide before onboarding users.
VITE_SPONSOR_GAS=false
VITE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Only used by the local Node deployment script. Use a dedicated Fuji test wallet.
DEPLOYER_PRIVATE_KEY=
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Evidence server: for an HTTPS deployment set APP_ORIGIN to the public app origin.
# APP_ORIGIN=https://your-app.example
API_PORT=4174
NULLMAPS_URL=http://127.0.0.1:8088
# Server only. Never use VITE_ for the shared Nullmaps API key.
NULLMAPS_API_KEY=
MAX_STORAGE_MB=1024
# Gas-free households (server only): a SEPARATE small Fuji wallet that pays gas for household actions
# (post lot, accept, dispute, cancel, redeem). Fund it with test AVAX. Never reuse the deployer/admin key.
RELAYER_PRIVATE_KEY=
# Optional relay limits
RELAY_DAILY_LIMIT=300
RELAY_HOURLY_PER_WALLET=20
# Runtime public contract override; otherwise use config/app.json.
# ECOLOOP_ADDRESS=0x...
# Persistent disk path on a public host.
# DATA_DIR=/data
# HOST=0.0.0.0
